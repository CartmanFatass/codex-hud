{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "APPROVED_NODE_QUOTED \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" --lifecycle",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "APPROVED_NODE_QUOTED \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" --lifecycle",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(hud:hud|hud|hud:setup)$",
        "hooks": [
          {
            "type": "command",
            "command": "APPROVED_NODE_QUOTED -e 'const r=require(\"node:child_process\").spawnSync(process.execPath,[process.argv[1]],{stdio:[0,\"pipe\",\"pipe\"],maxBuffer:8192,timeout:4200,killSignal:\"SIGKILL\"});if(r.error||r.status!==0)process.exit(1);try{const v=JSON.parse(r.stdout.toString());if(!v||Array.isArray(v)||typeof v!==\"object\"||v.decision!==\"block\")throw Error();process.stdout.write(JSON.stringify(v)+\"\\n\")}catch{process.exit(1)}' \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" || printf '%s\\n' '{\"decision\":\"block\",\"reason\":\"HUD: hook_startup_failed\",\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptExpansion\",\"suppressOriginalPrompt\":true}}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
