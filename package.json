{
  "name": "codex-hud",
  "version": "0.1.0",
  "description": "Real-time statusline HUD for OpenAI Codex CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-hud": "./bin/codex-hud",
    "hud-run": "./bin/hud-run",
    "hud": "./bin/hud"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "node ./node_modules/typescript/bin/tsc --watch",
    "start": "node dist/index.js",
    "test:render": "npm run build && node dist/index.js",
    "test:windows": "powershell -ExecutionPolicy Bypass -File ./tests/windows/test-powershell-entrypoints.ps1",
    "build:windows-policy": "node tools/build-windows-policy.mjs",
    "build:test": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && npm run test:unit && npm run test:mjs",
    "test:core": "bash tests/run-core.sh",
    "test:herdr": "bash tests/herdr/run.sh",
    "test:unit": "node --test dist-test/tests/unit/*.test.js",
    "test:mjs": "node --test tests/unit/*.mjs",
    "test:integration": "bash tests/run-integration.sh",
    "test:visual": "npm run build:test && node --test dist-test/tests/unit/visual-baselines.test.js",
    "test:visual:update": "node tests/update-visual-baselines.mjs",
    "check:fixtures": "bash tests/check-fixtures.sh",
    "check:fixtures:selftest": "bash tests/check-fixtures.selftest.sh",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write src tests",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check src tests",
    "build:hud-mcp": "node ./node_modules/typescript/bin/tsc -p packages/hud-mcp/tsconfig.json",
    "test:hud-mcp": "npm run build:hud-mcp && node --test packages/hud-mcp/dist/tests/hud-mcp/*.test.js"
  },
  "keywords": [
    "codex",
    "openai",
    "statusline",
    "hud",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.0.0"
  }
}
