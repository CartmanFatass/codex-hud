{
  "name": "codex-hud",
  "version": "0.1.0",
  "description": "Real-time statusline HUD for OpenAI Codex CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-hud": "./bin/codex-hud",
    "hud": "./bin/hud",
    "hud-statusline": "./bin/hud-statusline"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc && node scripts/copy-jev-assets.mjs dist",
    "dev": "node ./node_modules/typescript/bin/tsc --watch",
    "start": "node dist/index.js",
    "test:render": "npm run build && node dist/index.js",
    "build:test": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json && node scripts/copy-jev-assets.mjs dist-test",
    "test": "npm run build && npm run build:test && npm run build:hud-mcp && npm run test:unit && npm run test:mjs",
    "test:unit": "node tests/run-default.mjs",
    "test:mjs": "TZ=UTC node --test tests/unit/*.mjs",
    "snapshots:update": "npm run build && npm run build:test && node scripts/update-snapshots.mjs",
    "check:fixtures": "bash tests/check-fixtures.sh",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write src tests",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check src tests",
    "build:hud-mcp": "node ./node_modules/typescript/bin/tsc -p packages/hud-mcp/tsconfig.json"
  },
  "keywords": [
    "codex",
    "openai",
    "statusline",
    "hud",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.0.0"
  }
}
