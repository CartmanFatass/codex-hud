{
  "version": 1,
  "roles": [
    "flow",
    "frontend-imp",
    "general",
    "imp",
    "oracle",
    "pro",
    "reviewer",
    "sonic"
  ],
  "links": [],
  "role_files": [],
  "agents": [],
  "convention": false,
  "worktree": {
    "disposable": [
      "dist/**",
      "dist-test/**",
      "tmp/**",
      "hud-*.tar.gz"
    ]
  },
  "land": {
    "base": "universal-hud",
    "wrapper": "tmp/env.sh",
    "gate": [
      "npm run build",
