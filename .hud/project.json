{
  "version": 1,
  "roles": [
    "flow",
    "frontend-imp",
    "general",
    "imp",
    "oracle",
    "pro",
    "reviewer",
    "sonic"
  ],
  "links": [],
  "role_files": [],
  "agents": [],
  "convention": false,
  "worktree": {
    "disposable": [
      "dist/**",
      "dist-test/**",
      ".tsbuild/**",
      "tmp/**",
      "hud-*.tar.gz",
      "node_modules/**"
    ]
  },
  "worker_checks": {
    "imp": ["npm run build", "npm run build:test"],
    "frontend-imp": ["npm run build", "npm run build:test"]
  },
  "land": {
    "base": "universal-hud",
    "wrapper": "tmp/env.sh",
    "gate": [
      "npm run build",
      "npm run build:test",
      "npm run test:mjs",
      "npm run test:unit",
      "npm run check:fixtures"
    ],
    "after": [
      "npm run build"
    ],
    "push": true
  },
  "scratch": {
    "paths": [
      "tmp/tasks",
      "tmp/preview"
    ],
    "keep_days": 7
  }
}
