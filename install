#!/usr/bin/env bash
set -euo pipefail

REPO="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
HUD_HOME="${HUD_HOME:-$HOME/.hud}"
BIN_DIR="$HOME/.local/bin"
export REPO HUD_HOME BIN_DIR
uninstall=false
skip_build=false
selected=false
extensions=()
fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
valid_extension() { [[ "$1" =~ ^[a-zA-Z0-9_-]+$ && -f "$REPO/install.d/$1.sh" ]]; }

write_private() (
  target="$1"
  shift
  tmp="$(mktemp -- "$target.XXXXXX")"
  trap 'rm -f -- "$tmp"' EXIT
  printf '%s\n' "$@" > "$tmp"
  mv -Tf -- "$tmp" "$target"
)

save_extensions() {
  if ((${#installed[@]})); then
    write_private "$extension_file" "${!installed[@]}"
  else
    rm -f -- "$extension_file"
  fi
}

while (($#)); do
  case "$1" in
    --uninstall) uninstall=true; shift ;;
    --skip-build) skip_build=true; shift ;;
    --with)
      (($# >= 2)) && [[ -n "$2" && "$2" != ,* && "$2" != *, && "$2" != *,,* ]] || fail '--with requires comma-separated extension names'
      selected=true
      IFS=, read -r -a names <<< "$2"
      extensions+=("${names[@]}")
      shift 2 ;;
    *) fail "Unknown argument: $1" ;;
  esac
done

if $uninstall && ! $selected; then
  for file in "$REPO"/install.d/*.sh; do
    [[ -f "$file" ]] && extensions+=("$(basename "$file" .sh)")
  done
fi
# Validate every requested extension before building or changing anything.
for name in "${extensions[@]}"; do
  valid_extension "$name" || fail "Missing or invalid extension: $name"
done

# Refuse unsupported runtimes before invoking any extension or changing files.
command -v node >/dev/null || fail 'Node is required'
node -e 'const major = Number(process.versions.node.split(".")[0]); process.exit(major >= 24 ? 0 : 1)' || fail 'Node >=24.0.0 required'

extension_file="$HUD_HOME/installed-extensions"
declare -A installed=()
if [[ -f "$extension_file" ]]; then
  while IFS= read -r name; do
    if valid_extension "$name"; then installed[$name]=1; fi
  done < "$extension_file"
fi
if ! $uninstall && ! $selected; then
  extensions=("${!installed[@]}")
fi

if ! $uninstall; then
  for name in "${extensions[@]}"; do
    ( source "$REPO/install.d/$name.sh"; if declare -F hud_ext_check >/dev/null; then hud_ext_check; fi )
  done
fi

if $uninstall; then
  for name in "${extensions[@]}"; do
    printf 'Uninstalling extension: %s\n' "$name"
    ( source "$REPO/install.d/$name.sh"; hud_ext_uninstall )
    if [[ ${installed[$name]+x} ]]; then
      unset 'installed[$name]'
      save_extensions
    fi
  done
  if $selected; then
    printf 'Selected extensions uninstalled; core commands and data kept\n'
    exit 0
  fi
  worker="$HUD_HOME/pi-worker/hud-worker.mjs"
  if [[ ! -L "$HUD_HOME/pi-worker" && -L "$worker" && "$(readlink "$worker")" == "$REPO/integrations/pi/worker/hud-worker.mjs" ]]; then
    rm -- "$worker"
  fi
  rm -f -- "$extension_file"
  printf 'Removing command symlinks owned by this repo\n'
  for name in hud hud-mcp; do
    link="$BIN_DIR/$name"
    if [[ -L "$link" && "$(readlink -m "$link")" == "$REPO/"* ]]; then
      rm -- "$link"
    fi
  done
  printf 'HUD uninstalled; data kept at %s\n' "$HUD_HOME"
  exit 0
fi

cd "$REPO"
if $skip_build; then
  printf 'Skipping dependencies and build (--skip-build)\n'
else
  # Keep the hash with the dependency tree, not with the user's HUD configuration.
  # node, not sha256sum: the installer already needs node, and coreutils may be absent from PATH.
  lock_hash="$(node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync("package-lock.json")).digest("hex"))')"
  lock_stamp=node_modules/.hud-package-lock-hash
  if [[ ! -f "$lock_stamp" || "$(< "$lock_stamp")" != "$lock_hash" ]]; then
    printf 'Installing dependencies (npm ci)\n'
    rm -f -- "$lock_stamp"
    npm ci
    write_private "$lock_stamp" "$lock_hash"
  else
    printf 'Dependencies already present\n'
  fi
  printf 'Building HUD\n'
  npm run build || exit $?
fi
printf 'Ensuring HUD home: %s\n' "$HUD_HOME"
if [[ ! -d "$HUD_HOME" ]]; then
  mkdir -p -m 700 -- "$HUD_HOME"
fi
# Explicit -e entry for workers of every orchestrator. Never register it in interactive pi.
[[ ! -L "$HUD_HOME/pi-worker" ]] || fail "Worker directory is a symlink: $HUD_HOME/pi-worker"
mkdir -p -m 700 -- "$HUD_HOME/pi-worker"
worker="$HUD_HOME/pi-worker/hud-worker.mjs"
target="$REPO/integrations/pi/worker/hud-worker.mjs"
if [[ ! -L "$worker" || "$(readlink "$worker")" != "$target" ]]; then
  ln -sT -- "$target" "$worker" || fail "Worker entry already exists: $worker"
fi
printf 'Installing command symlinks in %s\n' "$BIN_DIR"
mkdir -p -- "$BIN_DIR"
for name in hud hud-mcp; do
  target="$REPO/bin/hud"
  [[ "$name" == hud-mcp ]] && target="$REPO/packages/hud-mcp/bin/hud-mcp.mjs"
  link="$BIN_DIR/$name"
  if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
    continue
  fi
  # A dangling command link is replaceable; keep live commands and user files.
  [[ ! -L "$link" || -e "$link" ]] || rm -- "$link"
  [[ ! -e "$link" && ! -L "$link" ]] || fail "Command already exists: $link"
  ln -s -- "$target" "$link"
done
for name in "${extensions[@]}"; do
  printf 'Installing extension: %s\n' "$name"
  ( source "$REPO/install.d/$name.sh"; hud_ext_install )
  # Preflight-only extensions do not install anything to refresh.
  case "$name" in browser|herdr) continue ;; esac
  if [[ ! ${installed[$name]+x} ]]; then
    installed[$name]=1
    save_extensions
  fi
done
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) printf 'Warning: %s is not on PATH; add it to use hud and hud-mcp.\n' "$BIN_DIR" >&2 ;;
esac
# Only Codex needs a launch function; the installer never edits shell rc files.
hud_functions=()
for name in "${extensions[@]}"; do
  case "$name" in
    codex) hud_functions+=("codexH() { hud codex \"\$@\"; }") ;;
  esac
done
if ((${#hud_functions[@]})); then
  printf 'HUD shell functions (paste into your shell rc; codexH leaves CODEX_HOME to the caller):\n'
  printf '%s\n' "${hud_functions[@]}"
fi
printf 'HUD installed; commands: %s/hud, %s/hud-mcp; data: %s\n' "$BIN_DIR" "$BIN_DIR" "$HUD_HOME"
