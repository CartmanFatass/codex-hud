#!/bin/bash
':' //; set +x; case $0 in /*) entry=$0;; *) entry=$PWD/$0;; esac; if [[ -L $entry ]]; then entry=$(exec readlink -f -- "$entry") || { printf 'HUD unavailable\n'; exit 0; }; fi; dir=${entry%/*}; helper=$dir/hud-statusline-cache.sh; if [[ -r $helper ]]; then source "$helper" "$entry" "$@"; fi; helper=$dir/hud-statusline-native.sh; if [[ -r $helper ]]; then source "$helper" "$entry" "$@"; fi; exec node "$entry" "$@"
const antigravityOnly = process.argv[2] === '--agy-render';
const args = process.argv.slice(antigravityOnly ? 3 : 2);
const admin = ['--help', 'import', 'settings'].includes(args[0]);
if (Number(process.versions.node.split('.')[0]) < 24) {
  if (admin) process.stderr.write('runtime_unavailable: Node >=24.0.0 required\n');
  else process.stdout.write('HUD unavailable\n');
  process.exitCode = admin ? 5 : 0;
} else {
  start();
}
import { withDistLock } from '../scripts/dist-lock.mjs';
async function start() {
  try {
    const { statuslineCommand } = await withDistLock(() => import('../dist/cli/statusline.js'));
    process.exitCode = await statuslineCommand(args, {
      env: process.env,
      stdout: (text) =>
        new Promise((resolve, reject) => {
          process.stdout.once('error', reject);
          process.stdout.write(text, (error) => (error ? reject(error) : resolve()));
        }),
      stderr: (text) => process.stderr.write(text),
    }, antigravityOnly);
  } catch {
    if (admin) {
      process.stderr.write('statusline_unavailable: run npm run build\n');
      process.exitCode = 1;
    } else {
      process.stdout.on('error', () => {});
      process.stdout.write('HUD unavailable\n');
      process.exitCode = 0;
    }
  }
}
