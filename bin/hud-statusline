#!/usr/bin/env node
import('../dist/cli/statusline.js')
  .then(async ({ statuslineCommand }) => {
    process.exitCode = await statuslineCommand(process.argv.slice(2), {
      env: process.env,
      stdout: (text) =>
        new Promise((resolve, reject) => {
          process.stdout.once('error', reject);
          process.stdout.write(text, (error) => (error ? reject(error) : resolve()));
        }),
      stderr: (text) => process.stderr.write(text),
    });
  })
  .catch(() => {
    process.stderr.write('statusline_unavailable: run npm run build\n');
    process.exitCode = 1;
  });
