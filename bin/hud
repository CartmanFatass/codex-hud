#!/usr/bin/env node
const major = Number(process.versions.node.split('.')[0]);
if (major < 24) {
  process.stderr.write('runtime_unavailable: Node >=24.0.0 required\n');
  process.exit(5);
}
if (process.argv[2] === 'uninstall') {
  const { realpathSync } = await import('node:fs');
  const { dirname, resolve } = await import('node:path');
  const { spawnSync } = await import('node:child_process');
  const installer = resolve(dirname(realpathSync(process.argv[1])), '../install');
  const result = spawnSync(installer, ['--uninstall', ...process.argv.slice(3)], { stdio: 'inherit' });
  if (result.error) process.stderr.write(`${result.error.message}\n`);
  process.exit(result.status ?? 1);
}
const compatibility = ['codex', 'codex-hud'].includes(process.argv[2]);
import(compatibility ? '../dist/cli/compat.js' : '../dist/cli/hud.js').then(async (module) => {
  process.exitCode = compatibility
      ? await module.codexCommand(process.argv.slice(3), { env: process.env })
      : await module.main();
}).catch(() => {
  process.stderr.write('internal_or_output_failure\n');
  process.exitCode = 1;
});
