#!/usr/bin/env node
// Only resume/cancel admission uses this timestamp; wait keeps a narrow monotonic clock.
const received = process.argv[2] === 'wait' ? undefined : performance.now();
const [major, minor] = process.versions.node.split('.').map(Number);
if (!((major === 22 && minor >= 13) || major >= 24) &&
    !['codex', 'codex-hud'].includes(process.argv[2])) {
  process.stderr.write('runtime_unavailable: Node 22.x >=22.13 or Node >=24 required (23 unsupported)\n');
  process.exit(5);
}
const compatibility = ['codex', 'codex-hud'].includes(process.argv[2]);
import(compatibility ? '../dist/cli/compat.js' : '../dist/cli/hud.js').then(async (module) => {
  process.exitCode = compatibility
    ? await module.codexCommand(process.argv.slice(3), { env: process.env })
    : await module.main(undefined, undefined, received);
}).catch(() => {
  process.stderr.write('internal_or_output_failure\n');
  process.exitCode = 1;
});
