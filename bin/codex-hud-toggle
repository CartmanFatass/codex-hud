#!/usr/bin/env bash
# Toggle the right-side subagent tree panel. Invoked from tmux keybinds so
# Codex-pane focus still works.
#
# The bar and the panel take turns: F12 swaps the one-line bar for the side
# panel, which shows the bar's fields at its foot, and back. Two views of the
# same session at once spent a row and a process on saying everything twice.
# The bar is recreated from the launch command persisted at session creation.
# When the statusline is off (@codex_hud_statusline=0), closing the panel
# leaves Codex alone in the window and F12 never creates a bar.
#
# Concurrency: rapid double-presses run this script twice concurrently, so
# every state read and pane mutation happens under a session-scoped wait-for
# lock. Failure ordering keeps the current HUD alive: the tree panel is
# created and verified before any other pane is touched.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HUD_DIR="$(dirname "$SCRIPT_DIR")"

ensure_single=0
focus_tree=0
open_only=0
click_x=""
expect_click=0
session_name=""
for arg in "$@"; do
  if [[ "$expect_click" == "1" ]]; then
    click_x="$arg"
    expect_click=0
    continue
  fi
  case "$arg" in
    --ensure-single) ensure_single=1 ;;
    # Open the panel if needed and put the cursor in it. F12 deliberately
    # leaves focus in the Codex pane, so this is the way to actually drive
    # the panel's keys without reaching for the mouse.
    --focus-tree) focus_tree=1 ;;
    # A click on the status bar at column X. Which field was under the cursor
    # decides what happens; see resolve_click below.
    --click) expect_click=1 ;;
    *) session_name="$arg" ;;
  esac
done

if [[ -z "$session_name" ]]; then
  session_name=$(tmux display-message -p '#{session_id}' 2>/dev/null || true)
fi
if [[ -z "$session_name" ]]; then
  exit 0
fi

# Serialize concurrent invocations for this session before reading any state.
lock_channel="codex-hud-toggle-${session_name}"
tmux wait-for -L "$lock_channel"
trap 'tmux wait-for -U "$lock_channel" 2>/dev/null || true' EXIT

get_opt() {
  tmux show-option -t "$session_name" -qv "$1" 2>/dev/null || true
}

mode=$(get_opt @codex_hud_mode)
mode=${mode:-single}
cwd=$(get_opt @codex_hud_cwd)
main_pane=$(get_opt @codex_hud_main_pane)
hud_pane=$(get_opt @codex_hud_pane)
tree_pane=$(get_opt @codex_hud_tree_pane)
hud_height=$(get_opt @codex_hud_height)
hud_height=${hud_height:-1}
hud_cmd=$(get_opt @codex_hud_hud_cmd)
session_start=$(get_opt @codex_hud_session_start)
codex_home=$(get_opt @codex_hud_codex_home)
# Missing option: older sessions still have the compact HUD.
statusline=$(get_opt @codex_hud_statusline)
statusline_enabled=1
if [[ "$statusline" == "0" ]]; then
  statusline_enabled=0
fi
# The HUD publishes what it drew, including which columns each field occupies,
# so a click can be answered with the field under the cursor rather than with
# one meaning for the whole bar. Everything here fails back to the old
# behaviour: no snapshot, no node, an unreadable file or an unrecognised
# column all mean "toggle", which is what the bar did before it had segments.
resolve_click() {
  [[ "$click_x" =~ ^[0-9]+$ ]] || return 0
  command -v node >/dev/null 2>&1 || return 0
  local click_map="$HUD_DIR/dist/utils/click-map.js"
  [[ -r "$click_map" ]] || return 0

  local tmux_session state_file action
  # The binding passes #{session_id} ($N); the state file is named after the
  # session name, which is what the HUD pane was given in its environment.
  tmux_session=$(tmux display-message -p -t "$session_name" '#{session_name}' 2>/dev/null | tr -d '\r\n')
  [[ -n "$tmux_session" ]] || return 0
  local home="${codex_home:-${CODEX_HOME:-$HOME/.codex}}"
  state_file="$home/hud/state/$(printf '%s' "$tmux_session" | tr -c 'A-Za-z0-9._-' '_').json"
  [[ -r "$state_file" ]] || return 0

  # Paths and the column arrive as arguments, never as script text.
  action=$(node --input-type=module -e '
    const { readFileSync } = await import("node:fs");
    const { pathToFileURL } = await import("node:url");
    const map = await import(pathToFileURL(process.argv[1]).href);
    process.stdout.write(map.clickActionFromSnapshot(readFileSync(process.argv[2], "utf8"), Number(process.argv[3])));
  ' "$click_map" "$state_file" "$click_x" 2>/dev/null) || return 0

  case "$action" in
    open-focus) focus_tree=1 ;;
    open) open_only=1 ;;
    *) ;;
  esac
}
resolve_click

cwd_q=$(printf '%q' "$cwd")
codex_home_q=$(printf '%q' "$codex_home")
toggle_q=$(printf '%q' "$SCRIPT_DIR/codex-hud-toggle")
session_q=$(printf '%q' "$session_name")

# Non-HUD sessions have no main pane option; F12 pass-through should have
# prevented this, but exit quietly if we still get here.
if [[ -z "$main_pane" ]]; then
  exit 0
fi

# A stale pane reference is not an error; the pane may already be gone.
# display-message exits 0 for a recently-killed pane id (empty #{pane_id}),
# so require the reported id to match.
pane_alive() {
  [[ -n "${1:-}" ]] || return 1
  local got
  got=$(tmux display-message -p -t "$1" '#{pane_id}' 2>/dev/null || true)
  [[ "$got" == "$1" ]]
}

create_hud_pane() {
  if [[ -z "$hud_cmd" ]]; then
    hud_cmd="cd ${cwd_q} && CODEX_HOME=${codex_home_q} CODEX_HUD_CWD=${cwd_q} CODEX_HUD_MAIN_PANE='$main_pane' CODEX_HUD_SESSION_START='$session_start' node '$HUD_DIR/dist/index.js'"
  fi

  if ! new_hud=$(tmux split-window -v -l "$hud_height" -t "$main_pane" -d -P -F '#{pane_id}' "$hud_cmd"); then
    tmux display-message -t "$session_name" "codex-hud: failed to recreate the bottom HUD"
    return 1
  fi
  if ! pane_alive "$new_hud"; then
    tmux display-message -t "$session_name" "codex-hud: recreated bottom HUD died immediately"
    return 1
  fi
  tmux set-option -t "$session_name" @codex_hud_pane "$new_hud"
  hud_pane="$new_hud"
  return 0
}

ensure_hud_pane() {
  if [[ "$statusline_enabled" != "1" ]]; then
    return 0
  fi
  if pane_alive "$hud_pane"; then
    return 0
  fi
  create_hud_pane
}

close_tree_pane() {
  tmux set-option -t "$session_name" @codex_hud_tree_pane ""
  tmux set-option -t "$session_name" @codex_hud_mode "single"
  if pane_alive "$tree_pane"; then
    tmux kill-pane -t "$tree_pane"
  fi
  tmux select-pane -t "$main_pane" 2>/dev/null || true
}

restore_single() {
  if ! pane_alive "$main_pane"; then
    return 0
  fi
  if [[ "$statusline_enabled" == "1" ]] && ! ensure_hud_pane; then
    return 1
  fi
  close_tree_pane
  return 0
}

if [[ "$ensure_single" == "1" ]]; then
  if [[ "$mode" == "single" ]] && { [[ "$statusline_enabled" != "1" ]] || pane_alive "$hud_pane"; }; then
    exit 0
  fi
  restore_single
  exit $?
fi

if [[ "$mode" == "tree" ]]; then
  if [[ "$focus_tree" == "1" || "$open_only" == "1" ]]; then
    if pane_alive "$tree_pane"; then
      # Already open. Focus it only when that is what was asked for: a glance
      # at a meter is not a reason to take the keyboard out of Codex.
      if [[ "$focus_tree" == "1" ]]; then
        tmux select-pane -t "$tree_pane" 2>/dev/null || true
      fi
      exit 0
    fi
    # The panel is gone but the session still thinks it is open; fall through
    # and rebuild it below.
    tmux set-option -t "$session_name" @codex_hud_tree_pane ""
    tmux set-option -t "$session_name" @codex_hud_mode "single"
    mode="single"
  else
    restore_single
    exit $?
  fi
fi

# single -> tree: open the fixed right-side panel, then retire the bar it
# replaces. The bar is touched only once the panel is up and alive.
if ! pane_alive "$main_pane"; then
  exit 0
fi

# A percentage split needs a client-provided window size and fails with
# "size missing" on detached sessions; compute an absolute width instead.
# display-message may print its error to stdout, so keep digits only.
# (Not `local`: this branch is at script scope.)
win_width=$(tmux display-message -p -t "$main_pane" '#{window_width}' 2>/dev/null | tr -dc '0-9' || true)
[[ -z "$win_width" ]] && win_width=120
# Default width is unchanged; explicit widths can expose the preview column.
panel_width=${CODEX_HUD_TREE_WIDTH:-0}
requested_width=0
if [[ "$panel_width" =~ ^[0-9]+$ && "$panel_width" -gt 0 ]]; then requested_width=$panel_width; fi
if [[ ! "$panel_width" =~ ^[0-9]+$ || "$panel_width" -le 0 ]]; then
  # Narrow unless a width is asked for (src/utils/pane-width.ts).
  panel_width=32
fi
if [[ "$panel_width" -lt 16 ]]; then panel_width=16; fi
max_panel=$(( win_width - 41 ))
if [[ "$max_panel" -lt 10 ]]; then max_panel=$(( win_width / 3 )); fi
if [[ "$panel_width" -gt "$max_panel" ]]; then panel_width=$max_panel; fi

tree_cmd="env CODEX_HUD_TREE_WIDTH='$requested_width' CODEX_HOME=${codex_home_q} CODEX_HUD_CWD=${cwd_q} CODEX_HUD_MAIN_PANE='$main_pane' CODEX_HUD_SESSION_START='$session_start' CODEX_HUD_TMUX_SESSION=${session_q} CODEX_HUD_TOGGLE_CMD=${toggle_q} node '$HUD_DIR/dist/tree-page.js'"
if ! new_tree=$(tmux split-window -h -l "$panel_width" -t "$main_pane" -d -P -F '#{pane_id}' "$tree_cmd"); then
  tmux display-message -t "$session_name" "codex-hud: failed to open the tree panel"
  exit 1
fi
if ! pane_alive "$new_tree"; then
  tmux display-message -t "$session_name" "codex-hud: tree panel died immediately"
  exit 1
fi

tmux set-option -t "$session_name" @codex_hud_tree_pane "$new_tree"
tmux set-option -t "$session_name" -q @codex_hud_mode "tree"
if pane_alive "$hud_pane"; then
  tmux kill-pane -t "$hud_pane" 2>/dev/null || true
fi
tmux set-option -t "$session_name" @codex_hud_pane ""
if [[ "$focus_tree" == "1" ]]; then
  tmux select-pane -t "$new_tree" 2>/dev/null || true
else
  # F12 never steals the cursor from Codex.
  tmux select-pane -t "$main_pane" 2>/dev/null || true
fi
