#!/usr/bin/env bash
#
# codex-hud - Wrapper script for Codex CLI with HUD display on the herdr pane strip
#
# Starts Codex directly in the current herdr pane (no tmux) and pushes the
# single-line status bar to herdr's bottom pane strip.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${CODEX_HUD_SCRIPT_DIR:-}" ]]; then
    SCRIPT_DIR="$CODEX_HUD_SCRIPT_DIR"
fi
HUD_DIR="$(dirname "$SCRIPT_DIR")"

if ! command -v node >/dev/null 2>&1; then
    echo "Error: Node.js 24+ is required." >&2
    exit 1
fi

if [[ "${1:-}" == "brief" && "${2:-}" == "--dry-run" ]]; then
    exec node "$HUD_DIR/bin/hud-dist.mjs" brief "${@:3}"
fi

# Build the HUD renderer if missing or stale (unless CODEX_HUD_SKIP_BUILD=1)
if [[ "${CODEX_HUD_SKIP_BUILD:-0}" != "1" ]]; then
    dist_file="$HUD_DIR/dist/index.js"
    launch_dist="$HUD_DIR/dist/cli/codex-launch.js"
    need_build=0

    if [[ ! -d "$HUD_DIR/node_modules" ]]; then
        echo "==> Installing dependencies..." >&2
        (cd "$HUD_DIR" && npm install) || { echo "Error: Failed to install dependencies" >&2; exit 1; }
    fi

    if [[ ! -f "$dist_file" || ! -f "$launch_dist" ]]; then
        need_build=1
    elif find "$HUD_DIR/src" -name '*.ts' -newer "$dist_file" 2>/dev/null | grep -q .; then
        need_build=1
    fi

    if [[ "$need_build" == "1" ]]; then
        echo "==> Building HUD renderer..." >&2
        (cd "$HUD_DIR" && npm run build) || { echo "Error: Failed to build HUD renderer" >&2; exit 1; }
    fi
fi

exec node "$HUD_DIR/bin/hud-dist.mjs" codex-launch "$@"
